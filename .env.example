# ===== UIT =====
UIT_USERNAME=26522248
UIT_PASSWORD=__CHANGE_ME__

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=

# ===== Scheduler (giây) =====
ANNOUNCEMENT_POLL_SECONDS=120
TKB_POLL_SECONDS=900
EXAM_POLL_SECONDS=1800

# ===== Digest =====
DIGEST_CRON=0 6 * * *
DIGEST_SEND_EMPTY=true
DIGEST_CATCHUP_UNTIL=12:00

# ===== Announcements =====
ANNOUNCEMENT_MODE=relevant
ANNOUNCEMENT_PAGE_SIZE=50
ANNOUNCEMENT_MAX_PAGES=5

# ===== Auth =====
AUTH_RELOGIN_MARGIN_MINUTES=15
AUTH_MAX_FAILURES=3
AUTH_ALERT_COOLDOWN_MINUTES=60

# ===== TKB / Exam =====
TKB_POLL_NEXT_WEEK=true
TKB_CONFIRM_REMOVALS=true
EXAM_YEARS=auto
EXAM_SEMESTERS=all

# ===== Courses UIT (Moodle) =====
COURSES_ENABLED=true
COURSES_BASE_URL=https://courses.uit.edu.vn
COURSES_POLL_SECONDS=120
COURSES_NOTIFICATION_LIMIT=50
COURSES_INCLUDE_MESSAGES=true
COURSES_SESSION_REFRESH_MARGIN_MINUTES=15

# ===== Runtime =====
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
STATE_DB_PATH=./data/state.db
DRY_RUN=false
HEARTBEAT_ENABLED=false

# ===== Fallback metadata (chỉ dùng khi không parse được trang TKB) =====
